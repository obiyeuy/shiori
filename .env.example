# Copy to .env. Do not commit real credentials. Use Node 24.19.0 and pnpm 11.19.0.
NODE_ENV=development
# Required: generate independent random database password and 32+ character session secret.
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgres://personal_site:replace-with-random-local-password@127.0.0.1:55432/personal_site
DATABASE_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=personal_site_session
# Required origin only (no path); HTTPS on server; localhost HTTP is development-only.
PUBLIC_SITE_URL=http://127.0.0.1:5173
# Local Compose web profile connects to this DB inside the independent db container.
APP_DATABASE_NAME=personal_site
# Optional group: all three or none; numeric ID is explicitly bound by local owner init.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_ID=
# P1 media / P4 backup directories. Never auto-clean retained media, backups, logs or test schemas.
MEDIA_ROOT=./.local/media
# Compose host directory, pre-create with app ownership and 0700 permissions.
MEDIA_ROOT_PATH=./.local/media
BODY_SIZE_LIMIT=110M
BACKUP_STATUS_ROOT=./.local/backup-status
# OWNER_PASSWORD is only supplied to the init command in a temporary shell environment.
# Never keep the owner password in this file.
